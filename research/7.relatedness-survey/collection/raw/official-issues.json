.com/users/Cynicarlos","html_url":"https://github.com/Cynicarlos","followers_url":"https://api.github.com/users/Cynicarlos/followers","following_url":"https://api.github.com/users/Cynicarlos/following{/other_user}","gists_url":"https://api.github.com/users/Cynicarlos/gists{/gist_id}","starred_url":"https://api.github.com/users/Cynicarlos/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Cynicarlos/subscriptions","organizations_url":"https://api.github.com/users/Cynicarlos/orgs","repos_url":"https://api.github.com/users/Cynicarlos/repos","events_url":"https://api.github.com/users/Cynicarlos/events{/privacy}","received_events_url":"https://api.github.com/users/Cynicarlos/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":3,"created_at":"2025-08-05T08:16:31Z","updated_at":"2025-08-05T09:01:28Z","closed_at":"2025-08-05T08:47:09Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Hi, the work is good but I encountered some problem when I try to reproduct the results of ZRR dataset. I used my script instead of yours, but I'm sure that the script is ok and the preprocess of the data is as same as yours. However, the result is much lower, which is psnr:7.4401     ssim:0.0833. Could you please give any ideas of what the possibility may be?  Thank you.\nThe test script is shown as follows.\n```python\ndef test(model, dataloader, save_image=False, save_dir=None):\n    model.eval()\n    psnr_sum = 0.0\n    ssim_sum = 0.0\n    lpips_sum = 0.0\n    total_samples = len(dataloader.dataset)\n    tqdm_loader = tqdm(dataloader, desc=\"Evaluating\", leave=False)\n\n    with open('zrr_results.txt', 'w') as f:\n        for idx, data in enumerate(tqdm_loader):\n            input_raw = data['lq'].cuda()\n            gt_rgb = data['gt'].cuda()\n            #img_demosaic = data['img_demosaic'].cuda()\n            #lq_path = data['lq_path'][0]#['E:\\\\Deep Learning\\\\datasets\\\\RAW\\\\Zurich-RAW-to-DSLR-Dataset\\\\test\\\\huawei_raw\\\\0.png']\n            #gt_path = data['gt_path'][0]\n            \n            pred_rgb = model(input_raw)\n            \n            pred_rgb = torch.clamp(pred_rgb, 0, 1)\n            gt_rgb = torch.clamp(gt_rgb, 0, 1)\n            \n            #lpips = get_lpips_torch(pred_rgb, gt_rgb)\n\n            pred_rgb =  pred_rgb * 255\n            gt_rgb = gt_rgb * 255\n            pred_rgb = pred_rgb.round()\n            gt_rgb = gt_rgb.round()\n\n            psnr = get_psnr_torch(pred_rgb, gt_rgb)\n            ssim = get_ssim_torch(pred_rgb, gt_rgb)\n\n            #f.write(f\"input:{lq_path}    gt:{gt_path}    psnr:{psnr.item():.4f}   ssim:{ssim.item():.4f}  lpips:{lpips.item():.4f}\\n\")\n            #f.write(f\"input:{lq_path}    gt:{gt_path}    psnr:{psnr.item():.4f}   ssim:{ssim.item():.4f}\\n\")\n\n            psnr_sum += psnr.item()\n            ssim_sum += ssim.item()\n            #lpips_sum += lpips.item()\n            #tqdm_loader.set_postfix({'psnr':f'{psnr.item():.4f}','ssim':f'{ssim.item():.4f}', 'lpips':f'{lpips.item():.4f}', 'avg_psnr': f'{psnr_sum/(idx+1):.4f}','avg_ssim':f'{ssim_sum/(idx+1):.4f}', 'avg_lpips': f'{lpips_sum/(idx+1):.4f}'}, refresh=True)\n            tqdm_loader.set_postfix({'psnr':f'{psnr.item():.4f}','ssim':f'{ssim.item():.4f}', 'avg_psnr': f'{psnr_sum/(idx+1):.4f}', 'avg_ssim':f'{ssim_sum/(idx+1):.4f}'}, refresh=True)\n            if save_image:\n                pred_rgb = pred_rgb.squeeze(0).cpu().numpy().astype(np.uint8)\n                save_path = os.path.join(save_dir, os.path.basename(lq_path)[:-4]) + '.jpg'\n                Image.fromarray(pred_rgb.transpose(1, 2, 0)).save(save_path)\n        \n        average_psnr = psnr_sum / total_samples\n        average_ssim = ssim_sum / total_samples\n        #average_lpips = lpips_sum / total_samples\n        #f.write(f'psnr:{average_psnr:.4f}       ssim:{average_ssim:.4f}     lpips:{average_lpips:.4f}')\n        f.write(f'psnr:{average_psnr:.4f}       ssim:{average_ssim:.4f}')\n    #print(f'psnr:{average_psnr:.4f}     ssim:{average_ssim:.4f}       lpips:{average_lpips:.4f}')\n    print(f'psnr:{average_psnr:.4f}     ssim:{average_ssim:.4f}')\n\nif __name__ == \"__main__\":\n    with open('configs/zrr.yaml', 'r') as file:\n        config = yaml.safe_load(file)\n    set_random_seed(config['manual_seed'])\n\n    model_name, model = build_model(config['model'])\n    model = model.cuda()\n    #checkpoint = torch.load('./runs/ZRR/checkpoints/best_model.pth')\n    #model.load_state_dict(checkpoint['model'])\n    #model.load_state_dict(torch.load(opt.config['model']['pretrained']))\n    model.load_state_dict(torch.load('pretrained/mai25_isp_challenge_best_slim.pkl'), strict=False)\n    #if opt.config['model']['type'] == 'original' and opt.config['model']['need_slim'] is True:\n    model = model.slim().to(\"cuda\")\n\n    test_dataloader = build_test_loader(config['data'])\n\n    #save_dir = f\"./visualization/{model_name}/ZRR_results\"\n    #os.makedirs(save_dir,exist_ok=True)\n    #test_align_gt_with_raw(model, test_dataloader, save_image=False, save_dir=None)\n    test(model, test_dataloader, save_image=False, save_dir=None)","closed_by":{"login":"LukasYan30","id":158446159,"node_id":"U_kgDOCXGyTw","avatar_url":"https://avatars.githubusercontent.com/u/158446159?v=4","gravatar_id":"","url":"https://api.github.com/users/LukasYan30","html_url":"https://github.com/LukasYan30","followers_url":"https://api.github.com/users/LukasYan30/followers","following_url":"https://api.github.com/users/LukasYan30/following{/other_user}","gists_url":"https://api.github.com/users/LukasYan30/gists{/gist_id}","starred_url":"https://api.github.com/users/LukasYan30/starre